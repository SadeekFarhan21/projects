{
  "type": "states",
  "title": "Thread states",
  "subtitle": "A static table of 32 threads and one FIFO run queue under a spinlock",
  "cols": 4,
  "rows": 3,
  "states": [
    {
      "id": "UNUSED",
      "label": "UNUSED",
      "x": 0,
      "y": 2,
      "kind": "start",
      "detail": "A free slot in the thread table"
    },
    {
      "id": "RUNNABLE",
      "label": "RUNNABLE",
      "x": 1,
      "y": 1,
      "detail": "Waiting on the run queue"
    },
    {
      "id": "RUNNING",
      "label": "RUNNING",
      "x": 2,
      "y": 1,
      "detail": "On a hart"
    },
    {
      "id": "SLEEPING",
      "label": "SLEEPING",
      "x": 1.5,
      "y": 0,
      "detail": "Blocked in sleep_on until a wakeup"
    },
    {
      "id": "ZOMBIE",
      "label": "ZOMBIE",
      "x": 3,
      "y": 2,
      "detail": "Exited, waiting for thread_join to reclaim it"
    }
  ],
  "edges": [
    {
      "from": "UNUSED",
      "to": "RUNNABLE",
      "label": "thread_create",
      "bend": 0
    },
    {
      "from": "RUNNABLE",
      "to": "RUNNING",
      "label": "sched picks",
      "bend": 0.3
    },
    {
      "from": "RUNNING",
      "to": "RUNNABLE",
      "label": "yield / preempt",
      "bend": 0.3
    },
    {
      "from": "RUNNING",
      "to": "SLEEPING",
      "label": "sleep_on",
      "bend": 0.2
    },
    {
      "from": "SLEEPING",
      "to": "RUNNABLE",
      "label": "wakeup",
      "bend": 0.2
    },
    {
      "from": "RUNNING",
      "to": "ZOMBIE",
      "label": "thread_exit",
      "bend": 0
    },
    {
      "from": "ZOMBIE",
      "to": "UNUSED",
      "label": "thread_join",
      "bend": 0
    }
  ]
}
