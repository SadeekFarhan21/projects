{
  "type": "flow",
  "title": "Two pipelines that end in one results folder",
  "subtitle": "The A/B side and the off-policy side share nothing but the output. Click a stage for details.",
  "steps": [
    {
      "lanes": [
        {
          "title": "A/B side",
          "steps": [
            {
              "name": "sim/eventlog.py",
              "role": "Or production logs",
              "kind": "source"
            },
            {
              "name": "DuckDB raw tables",
              "code": false,
              "role": "experiments, assignments, exposures, events",
              "kind": "store"
            },
            {
              "via": "SQL, first exposure, pre and post windows",
              "name": "user_metrics",
              "role": "One row per exposed user"
            },
            {
              "via": "SQL, SUM(y), SUM(y·y), SUM(x·y)",
              "name": "per-arm sufficient stats",
              "code": false,
              "role": "A handful of floats per arm",
              "details": [
                "Frozen dataclasses, MeanStats, RatioStats and CovariateStats, are the contract between SQL and Python"
              ]
            },
            {
              "via": "Python",
              "name": "tests",
              "code": false,
              "role": "Welch, delta, CUPED, SRM, Holm, BH, mSPRT",
              "kind": "output"
            }
          ]
        },
        {
          "title": "off-policy side",
          "steps": [
            {
              "name": "sim/bandit.py",
              "role": "Or Open Bandit CSVs",
              "kind": "source"
            },
            {
              "name": "numpy arrays",
              "code": false,
              "role": "obp layout, reward, action, pscore, position, action_dist (n, A, L)",
              "kind": "store"
            },
            {
              "name": "reward_model.py",
              "role": "K-fold cross-fit LightGBM, q_hat (n, A, L)"
            },
            {
              "name": "RowTerms",
              "role": "Per round, w, reward, dm, q_factual"
            },
            {
              "parallel": [
                {
                  "name": "estimators",
                  "code": false,
                  "role": "IPS, SNIPS, DM, DR, switch-DR"
                },
                {
                  "name": "bootstrap",
                  "code": false,
                  "role": "Multinomial resampling"
                }
              ]
            },
            {
              "name": "policy value and CI",
              "code": false,
              "role": "Percentile interval",
              "kind": "output"
            }
          ]
        }
      ]
    },
    {
      "name": "results/",
      "role": "Both sides write here",
      "kind": "store"
    }
  ],
  "extras": {
    "title": "Cross-check",
    "cards": [
      {
        "name": "obp",
        "role": "Every estimator is checked against Open Bandit Pipeline on identical arrays"
      }
    ]
  }
}
