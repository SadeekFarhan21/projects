{
  "name": "projects-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "figures": "esbuild figures/entry.ts --define:import.meta.env.BASE_URL='\"/\"' --bundle --minify --format=iife --target=es2020 --outfile=source/js/figures.js",
    "build": "npm run figures && hexo clean && hexo generate",
    "dev": "npm run figures && hexo server --draft",
    "new": "hexo new draft",
    "publish": "node tools/publish.mjs"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "hexo": "^8.1.2",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-search": "^2.4.3",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-markdown-it": "^7.1.1",
    "hexo-server": "^3.0.0"
  },
  "devDependencies": {
    "d3-array": "^3.2.4",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "esbuild": "^0.28.2"
  }
}
