      "x": 392.6,
      "y": 526.0,
      "width": 544.8,
      "height": 120.0,
      "text": "lf = lf.filter((pl.col(\"ingested_at\") <= as_of)\n             & (pl.col(\"available_at\") <= as_of))\n# Latest known version of each bar wins (restatements).\nlf = (lf.sort(\"ingested_at\")\n        .group_by([\"symbol\", \"date\"]).last()\n        ...)",
