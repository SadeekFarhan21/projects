   "width": 528.0,
   "height": 100.0,
   "text": "lf = lf.filter((pl.col(\"ingested_at\") <= as_of)\n             & (pl.col(\"available_at\") <= as_of))\n# Latest known version of each bar wins (restatements).\nlf = (lf.sort(\"ingested_at\")\n        .group_by([\"symbol\", \"date\"]).last()",
