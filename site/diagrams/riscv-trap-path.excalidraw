   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "yield() runs other threads on their own stacks.\nWhen this thread is picked again it returns out\nof kernel_trap and srets to where it was.",
   "originalText": "yield() runs other threads on their own stacks.\nWhen this thread is picked again it returns out\nof kernel_trap and srets to where it was.",
