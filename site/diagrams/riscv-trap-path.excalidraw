   "link": null,
   "locked": false,
   "text": "kernelvec:\n    csrw sscratch, t0\n    ld t0, CPU_KSTACK_LO(tp)\n    addi t0, t0, TF_SIZE\n    bltu sp, t0, kstack_overflow   /* pushing would fault again */\n    csrr t0, sscratch\n    addi sp, sp, -TF_SIZE\n    ...",
   "originalText": "kernelvec:\n    csrw sscratch, t0\n    ld t0, CPU_KSTACK_LO(tp)\n    addi t0, t0, TF_SIZE\n    bltu sp, t0, kstack_overflow   /* pushing would fault again */\n    csrr t0, sscratch\n    addi sp, sp, -TF_SIZE\n    ...",
