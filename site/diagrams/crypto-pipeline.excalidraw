      "boundElements": null,
      "link": null,
      "locked": false,
      "updated": 1,
      "roundness": null,
      "type": "text",
      "id": "bt_code_t",
      "x": 466,
      "y": 1194.0,
      "width": 566,
      "height": 120,
      "text": "W = weights.unstack(\"symbol\").fillna(0.0).sort_index()\nR = fwd_ret.unstack(\"symbol\").reindex_like(W).fillna(0.0)\nif lag:\n    W = W.shift(lag).fillna(0.0)\ngross = (W * R).sum(axis=1)\nturnover = W.diff().abs().sum(axis=1)",
      "originalText": "W = weights.unstack(\"symbol\").fillna(0.0).sort_index()\nR = fwd_ret.unstack(\"symbol\").reindex_like(W).fillna(0.0)\nif lag:\n    W = W.shift(lag).fillna(0.0)\ngross = (W * R).sum(axis=1)\nturnover = W.diff().abs().sum(axis=1)",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "bt_code",
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 14
