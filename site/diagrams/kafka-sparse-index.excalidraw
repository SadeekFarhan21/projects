      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "text": "To fetch offset n: binary search for the floor entry (a, pos_a) with a <= n,\nread from pos_a, skip the headers of records a to n-1, and return from n",
      "originalText": "To fetch offset n: binary search for the floor entry (a, pos_a) with a <= n,\nread from pos_a, skip the headers of records a to n-1, and return from n",
