      "updated": 1,
      "link": null,
      "locked": false,
      "text": "#define PX(level, va) ((((u64)(va)) >> (12 + 9 * (level))) & 0x1FF)\n#define PA2PTE(pa) ((((u64)(pa)) >> 12) << 10)\nu64 ad = PTE_A | ((perm & PTE_W) ? PTE_D : 0);\n*pte = PA2PTE(pa + off) | perm | ad | PTE_V;",
      "originalText": "#define PX(level, va) ((((u64)(va)) >> (12 + 9 * (level))) & 0x1FF)\n#define PA2PTE(pa) ((((u64)(pa)) >> 12) << 10)\nu64 ad = PTE_A | ((perm & PTE_W) ? PTE_D : 0);\n*pte = PA2PTE(pa + off) | perm | ad | PTE_V;",
      "fontSize": 18,
      "fontFamily": 3,
