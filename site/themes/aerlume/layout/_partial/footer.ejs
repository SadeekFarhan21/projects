<footer class="footer">
    <ul class="list-inline text-center">
        <% if (config.twitter_username) { %>
        <li>
            <a target="_blank" href="https://twitter.com/<%= config.twitter_username %>" aria-label="Twitter">
                <span class="fa-stack fa-lg">
                    <i class="iconfont icon-twitter" aria-hidden="true"></i>
                </span>
            </a>
        </li>
        <% } %>

        <% if (config.zhihu_username) { %>
        <li>
            <a target="_blank" href="https://www.zhihu.com/people/<%= config.zhihu_username %>" aria-label="Zhihu">
                <span class="fa-stack fa-lg">
                    <i class="iconfont icon-zhihu" aria-hidden="true"></i>
                </span>
            </a>
        </li>
        <% } %>

        <% if (config.weibo_username) { %>
        <li>
            <a target="_blank" href="https://weibo.com/<%= config.weibo_username %>" aria-label="Weibo">
                <span class="fa-stack fa-lg">
                    <i class="iconfont icon-weibo" aria-hidden="true"></i>
                </span>
            </a>
        </li>
        <% } %>

        <% if (config.facebook_username) { %>
        <li>
            <a target="_blank" href="https://www.facebook.com/<%= config.facebook_username %>" aria-label="Facebook">
                <span class="fa-stack fa-lg">
                    <i class="iconfont icon-facebook" aria-hidden="true"></i>
                </span>
            </a>
        </li>
        <% } %>

        <% if (config.linkedin_username) { %>
        <li>
            <a target="_blank" href="https://www.linkedin.com/in/<%= config.linkedin_username %>" aria-label="LinkedIn">
                <span class="fa-stack fa-lg">
                    <i class="iconfont icon-linkedin" aria-hidden="true"></i>
                </span>
            </a>
        </li>
        <% } %>

    </ul>

    <% if(config.friends) { %>
    <div class="footer-friends">
        <span class="footer-section-title">Friends</span>
        <span class="footer-friends-links">
            <% config.friends.forEach(function(friend, idx){ %>
                <a href="<%= friend.href %>" target="_blank" rel="friend"><%= friend.title %></a><% if(idx < config.friends.length - 1){ %><span class="footer-friends-sep" aria-hidden="true">·</span><% } %>
            <% }); %>
        </span>
    </div>
    <% }%>

    <div class="footer-bottom">
        <span class="footer-copyright">
            Built with <a href="https://hexo.io/">Hexo</a> · theme <a href="https://github.com/wu3227834/hexo-theme-aerlume">Aerlume</a>
        </span>
    </div>
</footer>

