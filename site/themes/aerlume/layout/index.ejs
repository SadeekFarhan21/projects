---
layout: layout
---

<h1 class="sr-only"><%= config.title %></h1>
<section class="post-preview-container" aria-labelledby="posts-heading" style="min-height: <%- config.per_page * 64 %>px">
    <h2 class="sr-only" id="posts-heading">Posts<% if (page.current > 1) { %>, Page <%= page.current %> of <%= page.total %><% } %></h2>
    <% page.posts.each(function(post){ %>
        <article class="post-preview">
            <div class="post-info">
                <a href="<%- url_for(post.path) %>">
                    <h3>
                        <%- (post.title || "Untitled" ).replace(/[<>&"]/g,function(c){
                            return {'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c];
                                }) %>
                    </h3>
                </a>
                <% if (post.tags.length){ %>
                <ul class="post-tags" aria-label="Tags">
                    <% post.tags.forEach(function(tag){ %>
                    <li><a class="tag-pill" href="<%= config.root %>tags/#<%= tag.name %>" title="All posts tagged <%= tag.name %>"><%= tag.name %></a></li>
                    <% }) %>
                </ul>
                <% } %>
            </div>
            <time class="post-time" datetime="<%= post.date.toISOString() %>">
                <%= post.date.format(config.date_format) %>
            </time>
        </article>
        <% }); %>
</section>
<%- partial('_partial/pager') %>
