---
layout: layout
---

<section class="post-preview-container" aria-labelledby="posts-heading" data-post-list>
    <h2 class="sr-only" id="posts-heading">Posts<% if (page.current > 1) { %>, Page <%= page.current %> of <%= page.total %><% } %></h2>
    <% page.posts.each(function(post){ %>
        <article class="post-preview">
            <div class="post-info">
                <a href="<%- url_for(post.path) %>">
                    <h3>
                        <%- (post.title || "Untitled" ).replace(/[<>&"]/g,function(c){
                            return {'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c];
                                }) %>
                    </h3>
                </a>
                <% var shownTags = display_tags(post.tags); if (shownTags.length){ %>
                <ul class="post-tags" aria-label="Tags">
                    <% shownTags.forEach(function(tag){ %>
                    <li><a class="tag-pill" href="<%= config.root %>tags/#<%= tag.name %>" title="All posts tagged <%= tag.name %>"><%= tag.name %></a></li>
                    <% }) %>
                </ul>
                <% } %>
            </div>
            <time class="post-time" datetime="<%= date_xml(post.date) %>"><%= date(post.date, config.date_format) %></time>
        </article>
        <% }); %>
</section>
<nav class="post-list-pager" aria-label="Post pages" hidden>
    <button type="button" data-page="newer">&larr; Newer</button>
    <span class="post-list-status" aria-live="polite"></span>
    <button type="button" data-page="older">Older &rarr;</button>
</nav>
<%- partial('_partial/pager') %>
<script src="<%- url_for('js/post-list.js') %>" defer></script>
