<div class="post-container">
    <h1 class="post-title">
        <%- page.title.replace(/[<>&"]/g,function(c){
            return {'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c];
        }) %>
    </h1>

<% var minutes = read_minutes(page); %>
    <div class="post-meta">
        <time class="post-date" datetime="<%= page.date.toISOString() %>"><%- page.date.format(config.date_format) %></time>
        <span class="post-meta-sep" aria-hidden="true">·</span>
        <span class="post-read"><%= minutes %> min read</span>
        <% if (page.code) { %>
        <a class="post-code" href="<%= page.code %>" target="_blank" rel="noopener" title="Code on GitHub" aria-label="Code on GitHub"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg></a>
        <% } %>
        <% var shownTags = display_tags(page.tags); if (shownTags.length){ %>
        <ul class="post-tags" aria-label="Tags">
            <% shownTags.forEach(function(tag){ %>
            <li><a class="tag-pill" href="<%= config.root %>tags/#<%= tag.name %>" title="All posts tagged <%= tag.name %>"><%= tag.name %></a></li>
            <% }) %>
        </ul>
        <% } %>
    </div>
    <div class="post-content <% if(config.post_style && !config.post_style.indent) {%>no-indent<% } %>">
        <%- page.content %>
        <% if(config.donate){%>
            <%- partial('_partial/donate', null, {cache: false}) %>
        <% } %>
        <br />
        <% if(page.comments && config.comment && config.comment.type === 'giscus'){ %>
            <div class="giscus"></div>
        <% } %>
    </div>
</div>
