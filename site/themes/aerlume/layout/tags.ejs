<% page.comments = false %>

<header class="tag-page-header">
    <p class="tag-page-eyebrow">Browse by topic</p>
    <h1>Tags</h1>
    <p class="tag-page-description"><%= site.tags.length %> tags across every write-up.</p>
</header>

<nav id='tag_cloud' class="tags" aria-label="Tag index">
    <% site.tags.map(a => a.name).sort((a, b) => {
        return a.localeCompare(b, 'zh-Hans-CN', {sensitivity: 'accent'})
    }).map(function(tag){  %>
    <a href="#<%= tag %>" class="tag-triangle" title="<%= tag %>"><i class="tag-i"><%= tag %></i></a>
    <% }) %>
</nav>

<!-- 标签列表 -->

<% site.tags.map(a => {
   return {
       name: a.name,
       posts: a.posts
   }
}).sort((a, b) => {
    return a.name.localeCompare(b.name, 'zh-Hans-CN', {sensitivity: 'accent'})
}).map(function(tag){  %>
<section class="one-tag-list">
                <span class="listing-seperator" id="<%= tag.name %>" role="heading" aria-level="2">
                    <span class="tag-text"><%= tag.name %></span>
                </span>
    <% tag.posts.map(function(post){  %>
    <!-- <li class="listing-item">
    <time datetime="{{ post.date | date:"%Y-%m-%d" }}">{{ post.date | date:"%Y-%m-%d" }}</time>
    <a href="{{ post.url }}" title="{{ post.title }}">{{ post.title }}</a>
    </li> -->
    <article class="post-preview">
        <a href="<%- config.root %><%- post.path %>">
            <h3 class="post-title">
                <%- (post.title || "Untitled").replace(/[<>&"]/g,function(c){
                    return {'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c];
                }) %>
            </h3>
            <% if (post.subtitle && post.subtitle.length) { %>
            <p class="post-subtitle">
                <%- post.subtitle %>
            </p>
            <% } %>
        </a>
        <!-- <p class="post-meta">{{ post.date | date:"%Y-%m-%d" }}</p> -->
    </article>
    <% }) %>
</section>
<% }) %>
