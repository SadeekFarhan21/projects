---
layout: layout
---

<%
var years = {};
// page.posts: this page's slice of the archive, year/month archive or tag page (already sorted newest first).
page.posts.forEach(function(post){
    var year = post.date.year()
    if(years[year]===undefined){
        years[year] = [];
    }
    years[year].push(post);
});
%>

<!-- 归档列表 -->

<%
var archiveHeading = page.tag ? 'Posts Tagged ' + page.tag
    : page.year ? 'Archive: ' + (page.month ? page.year + '-' + String(page.month).padStart(2, '0') : page.year)
    : 'Archive';
if (page.total > 1) archiveHeading += ', Page ' + page.current + ' of ' + page.total;
%>
<h1 class="sr-only"><%= archiveHeading %></h1>

<%# Paged to the screen by js/post-list.js, like the home page. %>
<div class="archives-container" data-post-list=".one-tag-list li">
<% Object.keys(years).reverse().forEach(function(year){  %>
<div class="one-tag-list" data-post-group>
                <span class="fa fa-calendar-times-o listing-seperator" id="<%= year %>" role="heading" aria-level="2">
                    <span class="tag-text"><%= year %></span>
                </span>
    <ul>
        <% years[year].map(function(post){  %>
        <!-- <li class="listing-item">
        <time datetime="{{ post.date | date:"%Y-%m-%d" }}">{{ post.date | date:"%Y-%m-%d" }}</time>
        <a href="{{ post.url }}" title="{{ post.title }}">{{ post.title }}</a>
        </li> -->
        <li >
            <span><%= post.date.format('MM-DD') %></span>
            <i class="fa fa-angle-double-right" aria-hidden="true"></i>
            <a href="<%- config.root %><%- post.path %>">
                        <span>
                            <%- (post.title || "Untitled").replace(/[<>&"]/g,function(c){
                                return {'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c];
                            }) %>
                        </span>
            </a>
            <!-- <p class="post-meta">{{ post.date | date:"%Y-%m-%d" }}</p> -->
        </li>
        <% }) %>

    </ul>
</div>
<% }) %>
</div>
<nav class="post-list-pager" aria-label="Archive pages" hidden>
    <button type="button" data-page="newer">&larr; Newer</button>
    <span class="post-list-status" aria-live="polite"></span>
    <button type="button" data-page="older">Older &rarr;</button>
</nav>
<script src="<%- url_for('js/post-list.js') %>" defer></script>
