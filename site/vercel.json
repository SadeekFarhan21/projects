{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/projects(/.*)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/posts/?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/posts/:n(\\d+)/?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/archives(/.*)?",
      "destination": "/archive/",
      "permanent": true
    },
    {
      "source": "/search/?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rss.xml",
      "destination": "/atom.xml",
      "permanent": true
    }
  ]
}
