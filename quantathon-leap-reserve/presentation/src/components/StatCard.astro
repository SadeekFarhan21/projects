---
interface Props {
  label: string;
  value: string;
  note?: string;
  accent?: boolean;
  warn?: boolean;
  small?: boolean;
  glass?: boolean;
  badge?: string;
  icon?: string;
  bottomBar?: boolean;
  delta?: string;
  deltaLabel?: string;
}
const { label, value, note, accent = false, warn = false, small = false, glass = false, badge, icon, bottomBar = false, delta, deltaLabel } = Astro.props;
---
<div class:list={['stat-card', { glass, 'has-bottom-bar': bottomBar }]}>
  <div class="stat-content">
    <div class="stat-header">
      <div class="stat-label-row">
        {accent && <span class="stat-dot"></span>}
        <span class="stat-label">{label}</span>
      </div>
      {icon && <div class="stat-icon" set:html={icon} />}
    </div>
    <div class="stat-value-row">
      <div class:list={['stat-value', { accent, warn, small }]}>{value}</div>
      {badge && <span class="stat-badge">{badge}</span>}
    </div>
    {note && <div class="stat-note">{note}</div>}
    {delta && (
      <div class="stat-delta-row">
        {deltaLabel && <span class="delta-label">{deltaLabel}</span>}
        <span class:list={['delta-value', { positive: !delta.startsWith('-') }]}>{delta}</span>
      </div>
    )}
  </div>
  {bottomBar && <div class="stat-bottom-bar"></div>}
</div>

<style>
  .stat-card {
    background: var(--surface);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    transition: box-shadow .35s var(--ease), transform .35s var(--ease);
  }
  .stat-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .stat-card.glass {
    background: var(--glass);
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
  }

  .stat-content {
    padding: 20px 24px;
    flex: 1;
    min-width: 0;
  }

  .stat-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .stat-label-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .stat-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--primary);
    flex-shrink: 0;
  }

  .stat-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--muted);
    font-weight: 600;
  }

  .stat-icon {
    width: 36px; height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--dim);
    flex-shrink: 0;
  }
  .stat-icon :global(svg) {
    width: 28px; height: 28px;
  }

  .stat-value-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .stat-value {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(28px, 3.5vw, 48px);
    font-weight: 800;
    line-height: 1.1;
    color: var(--ink);
    letter-spacing: -.02em;
  }
  .stat-value.accent { color: var(--primary); }
  .stat-value.warn { color: var(--accent-deep); }
  .stat-value.small { font-size: clamp(18px, 2.2vw, 30px); }

  .stat-badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    background: var(--primary);
    color: white;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    border-radius: 4px;
  }

  .stat-note {
    font-size: 12px;
    color: var(--muted);
    margin-top: 8px;
    line-height: 1.5;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .stat-delta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--border-light);
  }
  .delta-label {
    font-size: 13px;
    color: var(--muted);
  }
  .delta-value {
    font-size: 14px;
    font-weight: 700;
    color: var(--accent-deep);
  }
  .delta-value.positive {
    color: var(--success);
  }

  .stat-bottom-bar {
    height: 4px;
    background: var(--primary);
    flex-shrink: 0;
  }
</style>
