---
import LandingLayout from '../layouts/LandingLayout.astro';
import ChartCanvas from '../components/ChartCanvas.astro';
import summary from '../../../output/summary.json';

const ml = summary.ml_enhanced;
const base = summary.base;
const stress = summary.stress_tests;
const geo = summary.geographic;
const voi = summary.voi;
const be = summary.breakeven;
const mon = summary.monitoring;
const val = summary.validation;
const af = summary.adaptive_funding;
const rob = summary.robustness;

const fmt = (v: number) => `$${(v / 1e6).toFixed(2)}M`;
const fmtK = (v: number) => `$${(v / 1e3).toFixed(0)}K`;
const pct = (v: number) => `${(v * 100).toFixed(0)}%`;

// Chart data
const mlYears = Object.keys(ml.average_outflows);
const histogramData = summary.histogram;
const groupedBarData = {
  labels: ['Expected', '95%-Safe'],
  loan: [ml.loan_summary.mean, ml.loan_summary.p95],
  grant: [ml.grant_summary.mean, ml.grant_summary.p95],
};
const mlComboData = {
  labels: mlYears,
  outflows: mlYears.map((y: string) => ml.average_outflows[y]),
  inflows: mlYears.map((y: string) => ml.average_inflows[y]),
  cumulativeInflows: mlYears.map((_y: string, i: number) => {
    let sum = 0;
    for (let j = 0; j <= i; j++) sum += ml.average_inflows[mlYears[j]];
    return sum;
  }),
};
const tornadoData = {
  parameters: summary.tornado.parameters,
  base_p95: base.loan_summary.p95,
};
const recoveryData = {
  projection: summary.npv.extended_projection,
  milestones: summary.npv.recovery_milestones,
};
const funnelData = {
  labels: ['Interested applicants', 'Submitted applications', 'Completed loans', 'In-progress loans'],
  values: [127, 90, 42, 20],
};
const stressBarData = {
  labels: ['Base Case', ...stress.scenarios.map((s: any) => s.scenario_name)],
  values: [base.loan_summary.p95, ...stress.scenarios.map((s: any) => s.p95)],
  baseline: base.loan_summary.p95,
};
const voiBarData = {
  labels: voi.parameters.slice(0, 6).map((p: any) => p.parameter),
  values: voi.parameters.slice(0, 6).map((p: any) => p.dollar_voi),
  unit: 'currency',
};

// Year-by-year allocation prediction
const mlOrig = ml.average_originations || {};
const mlRepay = ml.average_repayments || {};
const yearByYear = mlYears.map((y: string, i: number) => {
  const outflow = ml.average_outflows[y];
  const inflow = ml.average_inflows[y];
  const originations = mlOrig[y] || 0;
  const repayments = mlRepay[y] || 0;
  // Cumulative net = total capital deployed minus recovered
  let cumulativeNet = 0;
  for (let j = 0; j <= i; j++) {
    cumulativeNet += ml.average_outflows[mlYears[j]] - ml.average_inflows[mlYears[j]];
  }
  return { year: y, outflow, inflow, net: outflow - inflow, cumulativeNet, originations, repayments };
});
const peakYear = yearByYear.reduce((max, row) => row.cumulativeNet > max.cumulativeNet ? row : max, yearByYear[0]);
---

<LandingLayout title="Columbus LEAP Funding Model">

<!-- ═════════════════════════════════��════════════════════ -->
<!-- ACT 1: PROBLEM & ASSUMPTIONS                           -->
<!-- ══════════════════════════════════════════════════════ -->

<!-- ═══ SLIDE 1: HERO ═══ -->
<section class="slide bg-surface">
  <div class="slide-content flex-1 flex flex-col justify-center px-8 md:px-16 pt-20 pb-16 max-w-[1400px] mx-auto w-full">
    <p class="font-label text-secondary text-[11px] uppercase tracking-[0.2em] mb-3 font-bold">Project: Quantathon 2026</p>
    <h1 class="font-headline text-5xl md:text-7xl font-bold tracking-tighter text-primary leading-none mb-6">
      Columbus LEAP<br/>Funding Model
    </h1>
    <p class="font-body text-lg text-on-primary-fixed-variant leading-relaxed max-w-2xl mb-4">
      How much should the City reserve in 2026 so a deferred-repayment water-line assistance fund stays solvent through 2037?
    </p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <div class="bg-surface-container-lowest p-6 rounded-xl ambient-shadow border-b-4 border-secondary">
        <div class="flex justify-between items-start mb-3">
          <span class="font-label text-[10px] uppercase tracking-wider text-secondary font-bold">Loan Model</span>
          <span class="material-symbols-outlined text-secondary text-xl">analytics</span>
        </div>
        <h3 class="font-headline text-sm font-bold text-primary mb-1">Recommended Reserve</h3>
        <div class="font-headline text-4xl font-bold tracking-tighter text-primary">{fmt(ml.loan_summary.p95)}</div>
        <p class="font-body text-[11px] text-on-primary-fixed-variant mt-2">Advanced model, 95% confidence of solvency</p>
      </div>
      <div class="bg-surface-container-lowest p-6 rounded-xl ambient-shadow">
        <div class="flex justify-between items-start mb-3">
          <span class="font-label text-[10px] uppercase tracking-wider text-on-primary-fixed-variant font-bold">Grant (no repayments)</span>
          <div class="bg-tertiary-fixed text-on-tertiary-container px-2 py-0.5 rounded-full flex items-center gap-1">
            <span class="material-symbols-outlined text-xs">trending_up</span>
            <span class="font-label text-[9px] font-bold">+{((ml.grant_summary.p95 / ml.loan_summary.p95 - 1) * 100).toFixed(0)}%</span>
          </div>
        </div>
        <h3 class="font-headline text-sm font-bold text-primary mb-1">If Structured as Grants</h3>
        <div class="font-headline text-4xl font-bold tracking-tighter text-primary">{fmt(ml.grant_summary.p95)}</div>
        <p class="font-body text-[11px] text-on-primary-fixed-variant mt-2">No money comes back to the City</p>
      </div>
      <div class="bg-surface-container-high p-6 rounded-xl flex flex-col items-center justify-center text-center">
        <span class="material-symbols-outlined text-secondary text-2xl mb-2">savings</span>
        <p class="font-label text-[10px] uppercase tracking-wider text-on-primary-fixed-variant mb-1">Capital Saved</p>
        <div class="font-headline text-3xl font-bold text-secondary">{fmt(ml.grant_summary.p95 - ml.loan_summary.p95)}</div>
        <p class="font-body text-[11px] text-on-primary-fixed-variant mt-1">Saved by using loans instead of grants</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ SLIDE 2: THE SCALE ═══ -->
<section class="slide bg-surface">
  <div class="slide-content flex-1 flex flex-col justify-center px-8 md:px-16 pt-20 pb-16 max-w-[1400px] mx-auto w-full">
    <p class="font-label text-secondary text-[11px] uppercase tracking-[0.2em] mb-3 font-bold">The Problem</p>
    <h2 class="font-headline text-4xl font-bold tracking-tighter text-primary mb-8">275,667 service lines. Federal deadline 2037.</h2>
    <div class="grid grid-cols-12 gap-6">
      <div class="col-span-12 lg:col-span-7 space-y-5">
        <div class="grid grid-cols-3 gap-4">
          <div class="bg-surface-container-lowest p-5 rounded-xl ambient-shadow text-center">
            <div class="font-headline text-3xl font-bold text-primary">275K</div>
            <p class="font-body text-[11px] text-on-primary-fixed-variant mt-1">Total service lines<br/>in Columbus</p>
          </div>
          <div class="bg-surface-container-lowest p-5 rounded-xl ambient-shadow text-center border-b-4 border-[#DC2626]">
            <div class="font-headline text-3xl font-bold text-[#DC2626]">91K</div>
            <p class="font-body text-[11px] text-on-primary-fixed-variant mt-1">Lead or galvanized<br/>(need replacement)</p>
          </div>
          <div class="bg-surface-container-lowest p-5 rounded-xl ambient-shadow text-center border-b-4 border-secondary">
            <div class="font-headline text-3xl font-bold text-secondary">34,269</div>
            <p class="font-body text-[11px] text-on-primary-fixed-variant mt-1">LEAP-eligible<br/>(private pipes)</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <span class="material-symbols-outlined text-[#DC2626] mt-0.5 flex-shrink-0">warning</span>
          <p class="text-on-primary-fixed-variant text-sm">The 2024 <strong class="text-primary">EPA Lead and Copper Rule Revision</strong> mandates all lead service lines be replaced by <strong class="text-primary">October 2037</strong>.</p>
        </div>
        <div class="flex gap-4 items-start">
          <span class="material-symbols-outlined text-secondary mt-0.5 flex-shrink-0">schedule</span>
          <p class="text-on-primary-fixed-variant text-sm">Columbus launched a <strong class="text-primary">12-year citywide replacement program in 2025</strong>. LEAP bridges the gap for homeowners who can't wait for the City to reach their street.</p>
        </div>
        <div class="bg-secondary/5 rounded-xl p-4 border-l-4 border-secondary">
          <p class="font-label text-[9px] uppercase tracking-widest text-secondary mb-1 font-bold">Our Goal</p>
          <p class="text-sm text-on-primary-fixed-variant">Determine the <strong class="text-primary">minimum upfront capital reserve</strong> that keeps LEAP solvent through 2037 with <strong class="text-primary">95% confidence</strong>, accounting for uncertain uptake, delayed repayments, and macroeconomic cycles.</p>
        </div>
      </div>
      <div class="col-span-12 lg:col-span-5">
        <div class="bg-primary rounded-xl p-6 text-white h-full flex flex-col justify-center">
          <p class="font-label text-[10px] uppercase tracking-widest text-white/50 mb-3 font-bold">Pipe Inventory Breakdown</p>
          <div class="space-y-3">
            {[
              { label: "Whole-line Lead", count: "22,431", pct: "8%", color: "bg-[#DC2626]" },
              { label: "Customer-side Galvanized", count: "14,892", pct: "5%", color: "bg-[#E97A2E]" },
              { label: "Lead and Galvanized overlap", count: "-3,054", pct: "", color: "bg-white/30" },
              { label: "Non-lead/Known safe", count: "184,667", pct: "67%", color: "bg-[#16A34A]" },
              { label: "Unknown", count: "56,731", pct: "20%", color: "bg-white/20" },
            ].map(item => (
              <div class="flex items-center gap-3">
                <div class={`w-3 h-3 rounded-sm ${item.color} flex-shrink-0`}></div>
                <span class="text-sm text-white/80 flex-1">{item.label}</span>
                <span class="font-headline font-bold text-sm">{item.count}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ SLIDE 3: FRAMING ═══ -->
<section class="slide bg-surface">
  <div class="slide-content flex-1 flex flex-col justify-center px-8 md:px-16 pt-20 pb-16 max-w-[1400px] mx-auto w-full">
    <p class="font-label text-secondary text-[11px] uppercase tracking-[0.2em] mb-3 font-bold">Framing</p>
    <h2 class="font-headline text-4xl font-bold tracking-tighter text-primary mb-8">How the model interprets LEAP</h2>
    <div class="grid grid-cols-12 gap-8">
      <div class="col-span-12 lg:col-span-7 space-y-5">
        <div class="flex gap-4 items-start">
          <span class="material-symbols-outlined text-secondary mt-0.5 flex-shrink-0">apartment</span>
          <p class="text-on-primary-fixed-variant">LEAP is a <strong class="text-primary">bridge fund</strong> for homes needing replacement before the City reaches them in the 2025-2037 scheduled program.</p>
        </div>
        <div class="flex gap-4 items-start">
          <span class="material-symbols-outlined text-secondary mt-0.5 flex-shrink-0">payments</span>
          <p class="text-on-primary-fixed-variant">The City advances up to <strong class="text-primary">$10,000</strong> per property as a 0% interest, 99-year loan. Repayment is a <strong class="text-primary">single lump sum</strong> on sale or equity withdrawal.</p>
        </div>
        <div class="flex gap-4 items-start">
          <span class="material-symbols-outlined text-secondary mt-0.5 flex-shrink-0">family_restroom</span>
          <p class="text-on-primary-fixed-variant"><strong class="text-primary">Inheritance alone</strong> does not trigger repayment — loans can persist for decades.</p>
        </div>
      </div>
      <div class="col-span-12 lg:col-span-5">
        <div class="bg-surface-container-low rounded-xl p-8 border-l-4 border-secondary h-full flex flex-col justify-center">
          <p class="font-label text-[10px] uppercase tracking-widest text-secondary mb-3 font-bold">Key Insight</p>
          <p class="font-body text-on-primary-fixed-variant leading-relaxed">
            The question is not "how much do replacements cost?" but <strong class="text-primary">"how much cash covers the timing gap</strong> between origination and repayment?"
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ SLIDE 4: ASSUMPTIONS — JUSTIFIED ═══ -->
<section class="slide bg-surface">
  <div class="slide-content flex-1 flex flex-col justify-center px-8 md:px-16 pt-20 pb-16 max-w-[1400px] mx-auto w-full">
    <div class="flex items-center gap-3 mb-6">
      <span class="material-symbols-outlined text-secondary text-2xl">psychology</span>
      <div>
        <p class="font-label text-secondary text-[11px] uppercase tracking-[0.2em] font-bold">Assumptions</p>
        <h2 class="font-headline text-3xl font-bold tracking-tighter text-primary">Every assumption is data-grounded</h2>
      </div>
    </div>
    <div class="grid grid-cols-12 gap-5">
      <div class="col-span-12 lg:col-span-8">
        <div class="bg-surface-container-lowest rounded-xl ambient-shadow overflow-hidden">
          <table class="w-full text-[13px] table-fixed">
            <colgroup>
              <col class="w-[18%]" />
              <col class="w-[12%]" />
              <col class="w-[12%]" />
              <col class="w-[58%]" />
            </colgroup>
            <thead><tr class="bg-surface-container-high">
              <th class="text-left px-4 py-2.5 font-label text-[9px] uppercase tracking-wider text-on-primary-fixed-variant">Parameter</th>
              <th class="text-center px-4 py-2.5 font-label text-[9px] uppercase tracking-wider text-on-primary-fixed-variant">Base</th>
              <th class="text-center px-4 py-2.5 font-label text-[9px] uppercase tracking-wider text-on-primary-fixed-variant">Range</th>
              <th class="text-left px-4 py-2.5 font-label text-[9px] uppercase tracking-wider text-secondary">Justification</th>
            </tr></thead>
            <tbody class="divide-y divide-outline-variant/15">
              {[
                ["Eligible lines", "34,269", "—", "Counted from City water system records — lead and galvanized pipes, after removing duplicates"],
                ["Uptake rate", "0.20%/yr", "0.16-0.25%", "Based on 62 actual loans in year 1; adjusted upward as program awareness grows"],
                ["Cost inflation", "3%/yr", "2-4%", "Based on consumer prices and construction labor costs; capped at $10K per LEAP rules"],
                ["Sale probability", "5.6%/yr", "4.5-6.5%", "Columbus homeowners stay ~18 years on average → about 1 in 18 sell each year"],
                ["Equity extraction", "2.0%/yr", "1.5-2.8%", "National cash-out refinance data for homeowners with sufficient equity"],
                ["Inheritance", "0.8%/yr", "0.6-1.2%", "Life expectancy data and Columbus homeowner demographics; does NOT trigger repayment"],
                ["Contractor cap", "120-250", "100-300", "LEAP program manager estimates; depends on available contractors"],
              ].map((row) => (
                <tr>
                  <td class="px-4 py-2.5 text-primary font-medium whitespace-nowrap">{row[0]}</td>
                  <td class="px-4 py-2.5 text-center font-bold text-primary whitespace-nowrap">{row[1]}</td>
                  <td class="px-4 py-2.5 text-center text-on-primary-fixed-variant whitespace-nowrap">{row[2]}</td>
                  <td class="px-4 py-2.5 text-on-primary-fixed-variant text-[11px] leading-tight">{row[3]}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <div class="col-span-12 lg:col-span-4 space-y-4">
        <div class="bg-surface-container-low rounded-xl p-5 border-l-4 border-secondary">
          <p class="font-label text-[9px] uppercase tracking-widest text-secondary mb-2 font-bold">Validation approach</p>
          <p class="text-xs text-on-primary-fixed-variant">Every assumption is tested across <strong class="text-primary">3 scenarios</strong> (optimistic, base, conservative). Tornado analysis quantifies how much each assumption moves the final answer.</p>
        </div>
        <div class="bg-surface-container-low rounded-xl p-5 border-l-4 border-[#E97A2E]">
          <p class="font-label text-[9px] uppercase tracking-widest text-[#C45A12] mb-2 font-bold">What we don't know</p>
          <ul class="text-xs text-on-primary-fixed-variant space-y-1">
            <li>- No street-level replacement schedule</li>
            <li>- No borrower age or mortgage data</li>
            <li>- Only ~1 year of LEAP operating history</li>
          </ul>
          <p class="text-xs text-on-primary-fixed-variant mt-2">These unknowns are why the P95 (not the mean) is the recommendation.</p>
        </div>
        <div class="bg-[#16A34A]/5 rounded-xl p-5 border-l-4 border-[#16A34A]">
          <p class="font-label text-[9px] uppercase tracking-widest text-[#16A34A] mb-1 font-bold">External sources</p>
          <p class="text-xs text-on-primary-fixed-variant">City program page, CFPB research, CDC life tables, BLS construction indices</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════════════ -->
<!-- ACT 2: DATA & DEMAND SIGNALS                          -->
<!-- ══════════════════════════════════════════════════════ -->

<!-- ═══ SLIDE 5: DATA FOUNDATION ═══ -->
