        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ SLIDE 5: PARTICIPATION FUNNEL ═══ -->
<section class="slide bg-surface">
  <div class="slide-content flex-1 flex flex-col justify-center px-8 md:px-16 pt-20 pb-16 max-w-[1400px] mx-auto w-full">
    <p class="font-label text-secondary text-[11px] uppercase tracking-[0.2em] mb-3 font-bold">Demand Signal</p>
    <h2 class="font-headline text-4xl font-bold tracking-tighter text-primary mb-8">Early LEAP adoption reveals demand patterns</h2>
    <div class="grid grid-cols-12 gap-6">
      <div class="col-span-12 lg:col-span-7">
        <ChartCanvas chartId="funnel" chartType="funnel" data={funnelData} />
        <div class="mt-4 flex gap-4">
          <div class="bg-surface-container-lowest p-3 rounded-xl ambient-shadow flex-1 text-center">
            <div class="font-headline text-lg font-bold text-secondary">33%</div>
            <p class="text-[10px] text-on-primary-fixed-variant">Overall conversion</p>
          </div>
          <div class="bg-surface-container-lowest p-3 rounded-xl ambient-shadow flex-1 text-center">
            <div class="font-headline text-lg font-bold text-secondary">$7,386</div>
            <p class="text-[10px] text-on-primary-fixed-variant">Avg. funded amount</p>
          </div>
          <div class="bg-surface-container-lowest p-3 rounded-xl ambient-shadow flex-1 text-center">
            <div class="font-headline text-lg font-bold text-secondary">$10,000</div>
            <p class="text-[10px] text-on-primary-fixed-variant">Hard cap per loan</p>
          </div>
        </div>
      </div>
      <div class="col-span-12 lg:col-span-5 space-y-4">
        <div class="bg-surface-container-low rounded-xl p-6 border-l-4 border-[#E97A2E]">
          <p class="font-label text-[9px] uppercase tracking-widest text-[#C45A12] mb-2 font-bold">Trigger Mix</p>
          <div class="flex gap-4 items-center mb-3">
            <div class="flex-1">
              <div class="h-3 rounded-full bg-surface-container-high overflow-hidden">
                <div class="h-full bg-[#E97A2E] rounded-full" style="width: 66%"></div>
              </div>
            </div>
          </div>
          <div class="flex justify-between text-xs text-on-primary-fixed-variant">
            <span><strong class="text-[#E97A2E]">66%</strong> Leak-driven (emergency)</span>
            <span><strong class="text-primary">34%</strong> Proactive</span>
          </div>
        </div>
        <div class="bg-surface-container-low rounded-xl p-6 border-l-4 border-secondary">
          <p class="font-label text-[9px] uppercase tracking-widest text-secondary mb-2 font-bold">Insurance Signal</p>
          <p class="text-sm text-on-primary-fixed-variant">WSL insurance policies grew from <strong class="text-primary">830 to 2,862</strong> in just 5 months — a <strong class="text-primary">245% increase</strong>. This leading indicator suggests significant latent demand for LEAP services.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ SLIDE 6: GEOGRAPHIC RISK ═══ -->
<section class="slide bg-surface">
  <div class="slide-content flex-1 flex flex-col justify-center px-8 md:px-16 pt-20 pb-16 max-w-[1400px] mx-auto w-full">
    <p class="font-label text-secondary text-[11px] uppercase tracking-[0.2em] mb-3 font-bold">Geography</p>
    <h2 class="font-headline text-4xl font-bold tracking-tighter text-primary mb-6">Risk is concentrated in 5 zip codes</h2>
    <div class="grid grid-cols-12 gap-6">
      <div class="col-span-12 lg:col-span-7">
        <div class="bg-surface-container-lowest rounded-xl ambient-shadow overflow-hidden">
          <table class="w-full text-sm">
            <thead><tr class="bg-surface-container-high">
              <th class="text-left p-3 font-label text-[9px] uppercase tracking-wider text-on-primary-fixed-variant">Zip Code</th>
              <th class="text-right p-3 font-label text-[9px] uppercase tracking-wider text-on-primary-fixed-variant">Parcels</th>
              <th class="text-right p-3 font-label text-[9px] uppercase tracking-wider text-on-primary-fixed-variant">Eligible %</th>
              <th class="text-right p-3 font-label text-[9px] uppercase tracking-wider text-on-primary-fixed-variant">Avg Lead Risk</th>
              <th class="text-right p-3 font-label text-[9px] uppercase tracking-wider text-secondary">Risk Score</th>
            </tr></thead>
            <tbody class="divide-y divide-outline-variant/15">
