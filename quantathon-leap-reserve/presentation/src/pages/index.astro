      {[
        { icon: "plumbing", title: "System Materials", stat: "34,269", desc: "Eligible lines (lead and galvanized)" },
        { icon: "request_quote", title: "LEAP Quotes", stat: "$6,950", desc: "Median from 64 funded amounts" },
        { icon: "group", title: "Participation", stat: "62", desc: "Loans completed and in-progress" },
        { icon: "trending_up", title: "Insurance", stat: "3,000", desc: "Active customers after 5 months" },
        { icon: "model_training", title: "Validation Data", stat: "10,000", desc: "Independent parcels to verify accuracy" },
      ].map((item) => (
        <div class="bg-surface-container-lowest p-5 rounded-xl ambient-shadow">
          <div class="w-9 h-9 rounded-lg machined-gradient flex items-center justify-center mb-3">
            <span class="material-symbols-outlined text-white text-lg">{item.icon}</span>
          </div>
