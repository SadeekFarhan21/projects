---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html class="light" lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <style is:global>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
    .machined-gradient {
      background: linear-gradient(135deg, #0058be 0%, #2170e4 100%);
    }
    .ambient-shadow {
      box-shadow: 0 20px 40px rgba(11, 28, 48, 0.06);
    }

    /* ══ Slide system ══ */
    html, body { overflow: hidden; height: 100vh; }
    .deck { position: relative; width: 100vw; height: 100vh; overflow: hidden; }

    .slide {
      position: absolute !important;
      inset: 0 !important;
      opacity: 0;
      pointer-events: none;
      transform: translateX(50px);
      transition: opacity 450ms cubic-bezier(.22,1,.36,1), transform 450ms cubic-bezier(.16,1,.3,1);
      will-change: transform, opacity;
      display: flex !important;
      flex-direction: column !important;
      overflow: hidden;
    }
    .slide.active {
      opacity: 1;
      pointer-events: auto;
      transform: translateX(0);
    }
    .slide.exit-left {
      opacity: 0;
      transform: translateX(-50px);
    }
    .slide.exit-right {
      opacity: 0;
      transform: translateX(50px);
    }
    .slide.enter-left {
      opacity: 0;
      transform: translateX(-50px);
      transition: none;
    }
    .slide.enter-right {
      opacity: 0;
      transform: translateX(50px);
      transition: none;
    }

    /* Stagger children */
    .slide .slide-content > * {
      opacity: 0;
      transform: translateY(14px);
    }
    .slide.active .slide-content > * {
      opacity: 1;
      transform: translateY(0);
      transition: opacity .45s cubic-bezier(.22,1,.36,1), transform .45s cubic-bezier(.16,1,.3,1);
    }
    .slide.active .slide-content > *:nth-child(1) { transition-delay: .08s; }
    .slide.active .slide-content > *:nth-child(2) { transition-delay: .16s; }
    .slide.active .slide-content > *:nth-child(3) { transition-delay: .24s; }
    .slide.active .slide-content > *:nth-child(4) { transition-delay: .32s; }
    .slide.active .slide-content > *:nth-child(5) { transition-delay: .40s; }
    .slide.active .slide-content > *:nth-child(6) { transition-delay: .48s; }

    @media print {
      html, body { overflow: visible; height: auto; }
      .deck { position: static; height: auto; overflow: visible; }
      .slide { position: relative !important; opacity: 1 !important; transform: none !important; pointer-events: auto !important; page-break-after: always; }
      .slide * { opacity: 1 !important; transform: none !important; transition: none !important; }
      .navbar, .slide-nav { display: none !important; }
    }
  </style>
</head>
<body class="bg-surface font-body text-on-surface selection:bg-secondary-fixed selection:text-on-secondary-fixed">

  <!-- Navbar -->
  <header class="navbar fixed top-0 left-0 right-0 h-16 bg-white/90 backdrop-blur-xl border-b border-outline-variant/15 z-50 flex items-center">
    <nav class="flex justify-between items-center w-full px-8 max-w-[1920px] mx-auto">
      <div class="text-lg font-bold text-primary tracking-tight font-headline">Columbus LEAP</div>
      <div class="hidden md:flex gap-6 items-center">
        <button type="button" class="font-label text-[10px] uppercase tracking-wider font-bold text-secondary cursor-pointer bg-transparent border-none p-0" data-nav="0">Overview</button>
        <button type="button" class="font-label text-[10px] uppercase tracking-wider font-medium text-on-primary-fixed-variant hover:text-secondary transition-colors cursor-pointer bg-transparent border-none p-0" data-nav="4">Data</button>
        <button type="button" class="font-label text-[10px] uppercase tracking-wider font-medium text-on-primary-fixed-variant hover:text-secondary transition-colors cursor-pointer bg-transparent border-none p-0" data-nav="7">Methodology</button>
        <button type="button" class="font-label text-[10px] uppercase tracking-wider font-medium text-on-primary-fixed-variant hover:text-secondary transition-colors cursor-pointer bg-transparent border-none p-0" data-nav="10">Results</button>
        <button type="button" class="font-label text-[10px] uppercase tracking-wider font-medium text-on-primary-fixed-variant hover:text-secondary transition-colors cursor-pointer bg-transparent border-none p-0" data-nav="14">Robustness</button>
        <button type="button" class="font-label text-[10px] uppercase tracking-wider font-medium text-on-primary-fixed-variant hover:text-secondary transition-colors cursor-pointer bg-transparent border-none p-0" data-nav="18">Decision</button>
      </div>
      <a href="/paper.pdf" download="Columbus_LEAP_Funding_Report.pdf" class="machined-gradient text-white px-5 py-2 rounded-lg font-label text-[10px] uppercase tracking-wider font-bold inline-block">Download Report</a>
    </nav>
  </header>

  <!-- Slide deck -->
  <main class="deck" id="deck">
    <slot />
  </main>

  <!-- Bottom nav -->
  <div class="slide-nav fixed bottom-0 left-0 right-0 h-12 bg-white/90 backdrop-blur-xl border-t border-outline-variant/15 z-50 flex items-center justify-center gap-6">
    <button id="prevBtn" class="w-8 h-8 rounded-full border border-outline-variant/30 flex items-center justify-center hover:bg-surface-container-high transition-colors">
      <span class="material-symbols-outlined text-on-primary-fixed-variant text-sm">chevron_left</span>
    </button>
    <div class="flex items-center gap-2 font-label text-sm tabular-nums">
      <span id="counterCurrent" class="font-bold text-secondary">01</span>
      <span class="text-outline-variant">/</span>
      <span id="counterTotal" class="text-outline-variant">11</span>
    </div>
    <div class="w-32 h-1 bg-surface-container-high rounded-full overflow-hidden">
      <div id="progressFill" class="h-full machined-gradient transition-all duration-500 ease-out" style="width:0%"></div>
    </div>
    <button id="nextBtn" class="w-8 h-8 rounded-full border border-outline-variant/30 flex items-center justify-center hover:bg-surface-container-high transition-colors">
      <span class="material-symbols-outlined text-on-primary-fixed-variant text-sm">chevron_right</span>
    </button>
  </div>

  <script>
    import '../charts/initCharts';
  </script>

  <script is:inline>
    const deck = document.getElementById('deck');
    const slides = Array.from(deck.querySelectorAll('.slide'));
    const counterCurrent = document.getElementById('counterCurrent');
    const counterTotal = document.getElementById('counterTotal');
    const progressFill = document.getElementById('progressFill');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const navLinks = document.querySelectorAll('[data-nav]');
    const total = slides.length;
    let current = 0;
    let transitioning = false;

    counterTotal.textContent = String(total).padStart(2, '0');
    slides.forEach(function(s, i) {
      // Force slide positioning (Tailwind CDN overrides <style>)
      s.style.position = 'absolute';
      s.style.inset = '0';
      s.style.display = 'flex';
      s.style.flexDirection = 'column';
      s.style.overflow = 'hidden';
      s.style.willChange = 'transform, opacity';
      // Ensure all slides have a solid background so nothing bleeds through
      if (!s.style.background && !s.getAttribute('style')?.includes('background')) {
        s.style.background = '#f8f9ff';
      }
      s.style.transition = 'opacity 450ms cubic-bezier(.22,1,.36,1), transform 450ms cubic-bezier(.16,1,.3,1)';
      if (i === 0) {
        s.classList.add('active');
        s.style.zIndex = '2';
        s.style.opacity = '1';
        s.style.pointerEvents = 'auto';
        s.style.transform = 'translateX(0)';
      } else {
        s.style.zIndex = '1';
        s.style.opacity = '0';
        s.style.pointerEvents = 'none';
        s.style.transform = 'translateX(50px)';
      }
    });
    updateUI();

    function goTo(target) {
      if (target === current || target < 0 || target >= total || transitioning) return;
      transitioning = true;
      var dir = target > current ? 1 : -1;
      var leaving = slides[current];
      var entering = slides[target];

      // Prep entering slide (no transition, off-screen)
      entering.style.transition = 'none';
      entering.style.transform = dir === 1 ? 'translateX(50px)' : 'translateX(-50px)';
      entering.style.opacity = '0';
      entering.style.zIndex = '3';
      entering.style.pointerEvents = 'auto';
      entering.classList.add('active');
      void entering.offsetWidth;

      // Animate entering slide in
      entering.style.transition = 'opacity 450ms cubic-bezier(.22,1,.36,1), transform 450ms cubic-bezier(.16,1,.3,1)';
      entering.style.transform = 'translateX(0)';
      entering.style.opacity = '1';

      // Animate leaving slide out
      leaving.style.transition = 'opacity 450ms cubic-bezier(.22,1,.36,1), transform 450ms cubic-bezier(.16,1,.3,1)';
      leaving.style.transform = dir === 1 ? 'translateX(-50px)' : 'translateX(50px)';
      leaving.style.opacity = '0';
      leaving.style.pointerEvents = 'none';
      leaving.classList.remove('active');

      current = target;
      updateUI();

      setTimeout(function() {
        leaving.style.zIndex = '1';
        entering.style.zIndex = '2';
        transitioning = false;
      }, 500);
    }

    function updateUI() {
      counterCurrent.textContent = String(current + 1).padStart(2, '0');
      progressFill.style.width = ((current / (total - 1)) * 100) + '%';

      // Highlight the active nav link based on current slide
      var navArr = Array.from(navLinks);
      // Sort nav targets ascending so we can find which section we're in
      var targets = navArr.map(function(l) { return parseInt(l.dataset.nav); }).sort(function(a, b) { return a - b; });
      // Find the highest target that is <= current slide
      var activeTarget = targets[0];
      for (var ti = 0; ti < targets.length; ti++) {
        if (targets[ti] <= current) activeTarget = targets[ti];
      }
      navArr.forEach(function(link) {
        var t = parseInt(link.dataset.nav);
        if (t === activeTarget) {
          link.className = 'font-label text-[10px] uppercase tracking-wider font-bold text-secondary';
        } else {
          link.className = 'font-label text-[10px] uppercase tracking-wider font-medium text-on-primary-fixed-variant hover:text-secondary transition-colors';
        }
      });
    }

    prevBtn.addEventListener('click', function() { goTo(current - 1); });
    nextBtn.addEventListener('click', function() { goTo(current + 1); });
    navLinks.forEach(function(link) {
      link.addEventListener('click', function() {
        goTo(parseInt(link.dataset.nav));
      });
    });

    document.addEventListener('keydown', function(e) {
      if (['ArrowRight','ArrowDown','PageDown',' '].indexOf(e.key) >= 0) { e.preventDefault(); goTo(current + 1); }
      else if (['ArrowLeft','ArrowUp','PageUp'].indexOf(e.key) >= 0) { e.preventDefault(); goTo(current - 1); }
      else if (e.key === 'Home') { e.preventDefault(); goTo(0); }
      else if (e.key === 'End') { e.preventDefault(); goTo(total - 1); }
    });

    var touchX = 0;
    deck.addEventListener('touchstart', function(e) { touchX = e.touches[0].clientX; }, { passive: true });
    deck.addEventListener('touchend', function(e) {
      var dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 60) goTo(current + (dx < 0 ? 1 : -1));
    }, { passive: true });
  </script>
</body>
</html>
