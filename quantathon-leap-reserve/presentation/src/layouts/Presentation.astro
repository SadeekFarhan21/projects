---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- Top navbar -->
  <header class="navbar">
    <div class="navbar-inner">
      <a class="navbar-brand" href="javascript:void(0)" onclick="goTo(0)">Quantathon 2026</a>
      <nav class="navbar-links" id="navLinks">
        <a href="#" class="nav-link active" data-slide="0">Model Overview</a>
        <a href="#" class="nav-link" data-slide="5">Funding Comparisons</a>
        <a href="#" class="nav-link" data-slide="8">Scenario Analysis</a>
      </nav>
      <a class="navbar-cta" href="/paper.pdf" target="_blank" rel="noopener">Download Report</a>
    </div>
  </header>

  <main class="deck" id="deck">
    <slot />
  </main>

  <!-- Slide indicator -->
  <div class="slide-indicator">
    <span class="indicator-line"></span>
    <div class="slide-counter" id="slideCounter">
      <span class="counter-current">01</span>
      <span class="counter-sep">/</span>
      <span class="counter-total">11</span>
    </div>
    <span class="indicator-line"></span>
  </div>

  <!-- Progress bar -->
  <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>

  <!-- Footer -->
  <footer class="site-footer">
    <span class="footer-copy">&copy; 2026 QUANTATHON EXECUTIVE MODEL</span>
  </footer>

  <script>
    const deck = document.getElementById('deck')!;
    const slides = Array.from(deck.querySelectorAll('.slide')) as HTMLElement[];
    const counterCurrent = document.querySelector('.counter-current')!;
    const counterTotal = document.querySelector('.counter-total')!;
    const progressFill = document.getElementById('progressFill')!;
    const navLinks = document.querySelectorAll('.nav-link[data-slide]');
    const total = slides.length;
    let current = 0;
    let transitioning = false;

    counterTotal.textContent = String(total).padStart(2, '0');

    // Nav link click handlers
    navLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const target = parseInt((link as HTMLElement).dataset.slide || '0');
        goTo(target);
      });
    });

    // Initialize: first slide active
    slides.forEach((s, i) => {
      if (i === 0) {
        s.classList.add('active');
        s.style.zIndex = '2';
      } else {
        s.style.zIndex = '1';
      }
    });
    updateUI();

    function goTo(target: number) {
      if (target === current || target < 0 || target >= total || transitioning) return;
      transitioning = true;

      const dir = target > current ? 1 : -1;
      const leaving = slides[current];
      const entering = slides[target];

      entering.classList.remove('active', 'exit-left', 'exit-right', 'enter-left', 'enter-right');
      entering.classList.add(dir === 1 ? 'enter-right' : 'enter-left');
      entering.style.zIndex = '3';

      void entering.offsetWidth;

      entering.classList.add('active');
      entering.classList.remove('enter-left', 'enter-right');

      leaving.classList.add(dir === 1 ? 'exit-left' : 'exit-right');
      leaving.classList.remove('active');

      current = target;
      updateUI();

      setTimeout(() => {
        leaving.classList.remove('exit-left', 'exit-right');
        leaving.style.zIndex = '1';
        entering.style.zIndex = '2';
        transitioning = false;
      }, 550);
    }

    function updateUI() {
      counterCurrent.textContent = String(current + 1).padStart(2, '0');
      progressFill.style.width = `${(current / (total - 1)) * 100}%`;

      // Update active nav link
      navLinks.forEach(link => {
        const slideIdx = parseInt((link as HTMLElement).dataset.slide || '0');
        link.classList.toggle('active', slideIdx === current ||
          (current >= slideIdx && current < getNextNavSlide(slideIdx)));
      });
    }

    function getNextNavSlide(currentNav: number): number {
      const navSlides = Array.from(navLinks).map(l => parseInt((l as HTMLElement).dataset.slide || '0')).sort((a, b) => a - b);
      const idx = navSlides.indexOf(currentNav);
      return idx < navSlides.length - 1 ? navSlides[idx + 1] : total;
    }

    // Keyboard
    document.addEventListener('keydown', (e) => {
      if (['ArrowRight','ArrowDown','PageDown',' '].includes(e.key)) { e.preventDefault(); goTo(current + 1); }
      else if (['ArrowLeft','ArrowUp','PageUp'].includes(e.key)) { e.preventDefault(); goTo(current - 1); }
      else if (e.key === 'Home') { e.preventDefault(); goTo(0); }
      else if (e.key === 'End') { e.preventDefault(); goTo(total - 1); }
    });

    // Touch swipe
    let touchX = 0;
    deck.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; }, { passive: true });
    deck.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 60) goTo(current + (dx < 0 ? 1 : -1));
    }, { passive: true });
  </script>

  <script>
    import '../charts/initCharts';
  </script>

  <style is:global>
    /* ━━━━━━━━━━━━ DESIGN TOKENS ━━━━━━━━━━━━ */
    :root {
      /* Surfaces */
      --bg: #F7F9FB;
      --surface: #FFFFFF;
      --surface-dim: #F0F2F5;
      --surface-container: #E8EAED;
      --surface-tint: rgba(0,88,190,.04);
      --glass: rgba(255,255,255,.82);
      --glass-strong: rgba(255,255,255,.92);

      /* Ink */
      --ink: #191C1E;
      --ink-soft: #42474E;
      --muted: #72787E;
      --dim: #ADB3B9;

      /* Primary */
      --primary: #2B52B4;
      --primary-deep: #1E3A8A;
      --primary-light: #D4E4F7;
      --primary-glow: rgba(43,82,180,.08);
      --primary-glow-strong: rgba(43,82,180,.16);
      --primary-surface: rgba(43,82,180,.05);

      /* Accent — warm amber */
      --accent: #E97A2E;
      --accent-deep: #C45A12;
      --accent-glow: rgba(233,122,46,.06);
      --accent-surface: rgba(233,122,46,.05);

      /* Semantic */
      --success: #16A34A;
      --success-surface: rgba(22,163,74,.06);

      /* Shadows */
      --shadow-xs: 0 1px 4px rgba(0,0,0,.03);
      --shadow-sm: 0 2px 16px rgba(0,0,0,.04);
      --shadow-md: 0 8px 32px rgba(0,0,0,.06);
      --shadow-lg: 0 20px 48px rgba(0,0,0,.08);
      --shadow-glow: 0 4px 24px rgba(43,82,180,.15);
      --shadow-inset: inset 0 1px 0 rgba(255,255,255,.7);

      /* Borders */
      --border: #E5E7EB;
      --border-light: #F0F1F3;

      /* Radii */
      --radius: 16px;
      --radius-sm: 12px;
      --radius-xs: 8px;

      /* Motion */
      --ease: cubic-bezier(.22,1,.36,1);
      --ease-out: cubic-bezier(.16,1,.3,1);
      --transition-slide: 500ms;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html {
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
      color: var(--ink);
      background: var(--bg);
      overflow: hidden;
      height: 100vh;
    }

    /* ━━━ Navbar ━━━ */
    .navbar {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: 64px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      z-index: 200;
      display: flex;
      align-items: center;
    }
    .navbar-inner {
      width: 100%;
      max-width: 1360px;
      margin: 0 auto;
      padding: 0 clamp(24px, 4vw, 56px);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .navbar-brand {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 800;
      font-size: 18px;
      color: var(--ink);
      text-decoration: none;
      letter-spacing: -.02em;
      flex-shrink: 0;
    }
    .navbar-links {
      display: flex;
      align-items: center;
      gap: 32px;
    }
    .nav-link {
      font-size: 14px;
      font-weight: 500;
      color: var(--muted);
      text-decoration: none;
      padding: 4px 0;
      transition: color .2s;
      position: relative;
    }
    .nav-link:hover { color: var(--ink); }
    .nav-link.active {
      color: var(--ink);
      font-weight: 600;
    }
    .nav-link.active::after {
      content: '';
      position: absolute;
      bottom: -2px; left: 0; right: 0;
      height: 2px;
      background: var(--primary);
      border-radius: 1px;
    }
    .navbar-cta {
      display: inline-flex;
      align-items: center;
      padding: 10px 20px;
      background: var(--primary);
      color: white;
      font-size: 14px;
      font-weight: 600;
      border-radius: var(--radius-xs);
      text-decoration: none;
      transition: background .2s, box-shadow .2s;
      flex-shrink: 0;
    }
    .navbar-cta:hover {
      background: var(--primary-deep);
      box-shadow: 0 4px 16px rgba(43,82,180,.25);
    }

    /* ━━━ Deck ━━━ */
    .deck {
      position: relative;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
    }

    /* ━━━ Typography ━━━ */
    h1, h2 {
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--ink);
      line-height: 1.1;
      letter-spacing: -.03em;
      font-weight: 800;
    }
    h1 {
      font-size: clamp(36px, 4.8vw, 56px);
    }
    h2 {
      font-size: clamp(24px, 3vw, 40px);
      font-weight: 700;
    }
    h3 {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: clamp(14px, 1.5vw, 19px);
      font-weight: 600;
      color: var(--ink-soft);
      letter-spacing: -.01em;
    }
    p, li {
      font-size: clamp(13px, 1.35vw, 17px);
      line-height: 1.65;
      color: var(--ink-soft);
    }
    li { margin-bottom: 4px; }
    li::marker { color: var(--primary); }
    ul { padding-left: 20px; }
    strong { color: var(--ink); font-weight: 600; }
    .accent { color: var(--primary); font-weight: 600; }
    .warn   { color: var(--accent-deep); font-weight: 600; }

    /* ━━━ Charts ━━━ */
    .chart {
      width: 100%;
      max-height: 50vh;
      object-fit: contain;
      border-radius: var(--radius);
      background: var(--surface);
      padding: 8px;
      box-shadow: var(--shadow-sm);
      transition: box-shadow .35s var(--ease), transform .35s var(--ease);
    }
    .chart:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-1px);
    }

    /* ━━━ Tables ━━━ */
    table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      font-size: clamp(12px, 1.2vw, 16px);
    }
    th {
      color: var(--muted);
      font-size: clamp(9px, .85vw, 11px);
      font-weight: 600;
      letter-spacing: .1em;
      text-transform: uppercase;
      padding: 10px 14px;
      text-align: left;
      background: var(--surface-dim);
    }
    th:first-child { border-radius: var(--radius-xs) 0 0 0; }
    th:last-child { border-radius: 0 var(--radius-xs) 0 0; }
    td {
      padding: 10px 14px;
      text-align: left;
      transition: background .15s;
    }
    tbody tr:nth-child(even) td { background: var(--surface-tint); }
    tbody tr:hover td { background: var(--primary-glow); }

    /* ━━━ Slide Indicator (centered counter with lines) ━━━ */
    .slide-indicator {
      position: fixed;
      bottom: 48px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 16px;
      z-index: 150;
    }
    .indicator-line {
      width: 80px;
      height: 1px;
      background: var(--dim);
    }
    .slide-counter {
      display: flex;
      align-items: baseline;
      gap: 6px;
      font-variant-numeric: tabular-nums;
    }
    .counter-current {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 700;
      font-size: 16px;
      color: var(--primary);
      letter-spacing: -.02em;
    }
    .counter-sep {
      font-size: 13px;
      color: var(--dim);
    }
    .counter-total {
      font-size: 14px;
      color: var(--dim);
      font-weight: 500;
    }

    /* ━━━ Progress bar ━━━ */
    .progress-track {
      position: fixed;
      bottom: 38px;
      left: 50%;
      transform: translateX(-50%);
      width: 220px;
      height: 3px;
      background: var(--surface-dim);
      z-index: 150;
      border-radius: 2px;
    }
    .progress-fill {
      height: 100%; width: 0;
      background: var(--primary);
      transition: width .5s var(--ease);
      border-radius: 2px;
    }

    /* ━━━ Footer ━━━ */
    .site-footer {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 clamp(24px, 4vw, 56px);
      z-index: 150;
      background: var(--surface);
      border-top: 1px solid var(--border-light);
    }
    .footer-copy {
      font-size: 10px;
      font-weight: 500;
      letter-spacing: .06em;
      color: var(--muted);
    }
    /* ━━━ Slide transition classes ━━━ */
    .slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      pointer-events: none;
      transition:
        opacity var(--transition-slide) var(--ease),
        transform var(--transition-slide) var(--ease-out);
      transform: translateX(60px);
      will-change: transform, opacity;
    }
    .slide.active {
      opacity: 1;
      pointer-events: auto;
      transform: translateX(0);
    }
    .slide.exit-left {
      opacity: 0;
      transform: translateX(-60px);
    }
    .slide.exit-right {
      opacity: 0;
      transform: translateX(60px);
    }
    .slide.enter-left {
      opacity: 0;
      transform: translateX(-60px);
      transition: none;
    }
    .slide.enter-right {
      opacity: 0;
      transform: translateX(60px);
      transition: none;
    }

    /* ━━━ Stagger entrance ━━━ */
    .slide .slide-body > * {
      opacity: 0;
      transform: translateY(18px);
    }
    .slide.active .slide-body > * {
      opacity: 1;
      transform: translateY(0);
      transition: opacity .5s var(--ease), transform .5s var(--ease-out);
    }
    .slide.active .slide-body > *:nth-child(1) { transition-delay: .1s; }
    .slide.active .slide-body > *:nth-child(2) { transition-delay: .19s; }
    .slide.active .slide-body > *:nth-child(3) { transition-delay: .28s; }
    .slide.active .slide-body > *:nth-child(4) { transition-delay: .37s; }
    .slide.active .slide-body > *:nth-child(5) { transition-delay: .46s; }

    /* ━━━ Kicker entrance ━━━ */
    .slide .kicker-line {
      transform: scaleX(0);
      transform-origin: left;
    }
    .slide.active .kicker-line {
      transform: scaleX(1);
      transition: transform .5s var(--ease-out);
    }
    .slide .kicker-text {
      opacity: 0;
      transform: translateX(-8px);
    }
    .slide.active .kicker-text {
      opacity: 1;
      transform: translateX(0);
      transition: opacity .4s var(--ease), transform .4s var(--ease-out);
      transition-delay: .06s;
    }

    /* ━━━ Title underline accent ━━━ */
    h2::after {
      content: '';
      display: block;
      width: 40px;
      height: 3px;
      background: linear-gradient(90deg, var(--primary), var(--accent));
      border-radius: 2px;
      margin-top: 10px;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform .6s var(--ease);
    }
    .slide.active h2::after {
      transform: scaleX(1);
      transition-delay: .12s;
    }
    .slide--dark h2::after,
    .slide--hero h2::after {
      display: none;
    }

    /* ━━━ Print ━━━ */
    @media print {
      body { background: white; overflow: visible; }
      .navbar, .slide-indicator, .progress-track, .site-footer { display: none; }
      .deck { position: static; height: auto; overflow: visible; }
      .slide {
        position: relative !important;
        opacity: 1 !important;
        transform: none !important;
        pointer-events: auto !important;
        page-break-after: always;
      }
      .slide * { opacity: 1 !important; transform: none !important; transition: none !important; }
    }

    @media (max-width: 768px) {
      .navbar-links { display: none; }
    }
  </style>
</body>
</html>
