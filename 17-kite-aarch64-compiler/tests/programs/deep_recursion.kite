// Recursion 10000 frames deep.
fn sum_to(n: int) -> int {
    if n == 0 {
        return 0;
    }
    return n + sum_to(n - 1);
}

fn count_down(n: int, acc: [int]) {
    if n == 0 {
        return;
    }
    acc[0] = acc[0] + 1;
    count_down(n - 1, acc);
}

fn main() {
    println(sum_to(10000));
    let acc = [0];
    count_down(10000, acc);
    println(acc[0]);
}
