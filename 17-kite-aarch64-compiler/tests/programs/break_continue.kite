// break and continue in while and for loops, including nested loops.
fn main() {
    for i in 0..10 {
        if i == 7 {
            break;
        }
        if i % 2 == 0 {
            continue;
        }
        print(i);
    }
    println();
    var i = 0;
    while true {
        i = i + 1;
        if i > 20 {
            break;
        }
        if i % 5 != 0 {
            continue;
        }
        print(i);
        print(" ");
    }
    println();
    var pairs = 0;
    for a in 0..10 {
        for b in 0..10 {
            if b > a {
                break;
            }
            if (a + b) % 3 == 0 {
                continue;
            }
            pairs = pairs + 1;
        }
    }
    println(pairs);
}
