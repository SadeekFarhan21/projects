// More live values than the 10 allocatable registers, kept across calls,
// to force spilling in the register allocator.
fn id(x: int) -> int {
    return x;
}

fn main() {
    let a = id(1);
    let b = id(2);
    let c = id(3);
    let d = id(4);
    let e = id(5);
    let f = id(6);
    let g = id(7);
    let h = id(8);
    let i = id(9);
    let j = id(10);
    let k = id(11);
    let l = id(12);
    let m = id(13);
    let n = id(14);
    let sum = a + b + c + d + e + f + g + h + i + j + k + l + m + n;
    println(sum);
    println(a * n + b * m + c * l + d * k + e * j + f * i + g * h);
    var acc = 0;
    for r in 0..100 {
        acc = acc + id(a) + b + c + d + e + f + g + h + i + j + k + l + m + id(n) + r;
    }
    println(acc);
}
