// Trial-division primality and the sum of primes below 5000.
fn is_prime(n: int) -> bool {
    if n < 2 {
        return false;
    }
    var d = 2;
    while d * d <= n {
        if n % d == 0 {
            return false;
        }
        d = d + 1;
    }
    return true;
}

fn main() {
    var count = 0;
    var sum = 0;
    for n in 0..5000 {
        if is_prime(n) {
            count = count + 1;
            sum = sum + n;
        }
    }
    println(count);
    println(sum);
}
