// Matrix multiply on flat arrays.
fn matmul(a: [int], b: [int], n: int) -> [int] {
    var c = [0; n * n];
    for i in 0..n {
        for j in 0..n {
            var s = 0;
            for k in 0..n {
                s = s + a[i * n + k] * b[k * n + j];
            }
            c[i * n + j] = s;
        }
    }
    return c;
}

fn main() {
    let n = 3;
    let a = [1, 2, 3, 4, 5, 6, 7, 8, 9];
    let id = [1, 0, 0, 0, 1, 0, 0, 0, 1];
    let c = matmul(a, a, n);
    for i in 0..n * n {
        print(c[i]);
        print(" ");
    }
    println();
    let d = matmul(a, id, n);
    var same = true;
    for i in 0..n * n {
        if d[i] != a[i] {
            same = false;
        }
    }
    println(same);
}
