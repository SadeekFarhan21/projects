// for loops over half-open ranges.
fn main() {
    for i in 0..5 {
        print(i);
    }
    println();
    for i in 5..5 {
        println("empty range body");
    }
    for i in 10..3 {
        println("reversed range body");
    }
    for i in -3..2 {
        print(i);
        print(",");
    }
    println();
    // bounds are evaluated once
    var n = 3;
    for i in 0..n {
        n = n + 1;
    }
    println(n);
    var total = 0;
    for i in 0..10 {
        for j in 0..i {
            total = total + j;
        }
    }
    println(total);
}
