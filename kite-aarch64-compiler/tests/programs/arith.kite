// Integer arithmetic and operator precedence.
fn main() {
    println(1 + 2 * 3);
    println((1 + 2) * 3);
    println(10 - 4 - 3);
    println(100 / 10 / 5);
    println(2 * 3 + 4 * 5);
    println(-5 + 3);
    println(-(5 + 3));
    println(--7);
    println(17 % 5);
    println(1 + 2 * 3 - 4 / 2 + 10 % 4);
    let x = 7;
    let y = x * x - 2 * x + 1;
    println(y);
    var z = 0;
    z = z + x;
    z = z * 3;
    println(z);
}
