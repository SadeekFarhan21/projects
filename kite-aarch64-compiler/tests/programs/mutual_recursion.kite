// Top-level functions may call each other in any order.
fn is_even(n: int) -> bool {
    if n == 0 {
        return true;
    }
    return is_odd(n - 1);
}

fn is_odd(n: int) -> bool {
    if n == 0 {
        return false;
    }
    return is_even(n - 1);
}

fn main() {
    for i in 0..8 {
        print(is_even(i));
        print(" ");
    }
    println();
    println(is_odd(777));
}
