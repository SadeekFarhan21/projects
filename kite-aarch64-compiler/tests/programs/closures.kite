// Closures capture immutable bindings by value.
fn make_adder(n: int) -> fn(int) -> int {
    return fn(x: int) -> int {
        return x + n;
    };
}

fn apply_twice(f: fn(int) -> int, x: int) -> int {
    return f(f(x));
}

fn main() {
    let add5 = make_adder(5);
    let add10 = make_adder(10);
    println(add5(1));
    println(add10(1));
    println(apply_twice(add5, 0));
    let k = 3;
    let times_k = fn(x: int) -> int {
        return x * k;
    };
    println(times_k(7));
    println(apply_twice(times_k, 2));
    let greeting = "hi ";
    let greet = fn(name: string) -> string {
        return greeting + name;
    };
    println(greet("kite"));
    // a closure with no captures and no return value
    let say = fn() {
        println("said");
    };
    say();
    say();
}
